{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "enabledManagers": ["nix", "github-actions", "custom.regex"],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update OCI image refs (tag + digest) in policy/oci-images.nix",
      "managerFilePatterns": ["/policy/oci-images\\.nix$/"],
      "matchStrings": [
        "\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the hermes-agent release pin in modules/agents/hermes.nix",
      "managerFilePatterns": ["/modules/agents/hermes\\.nix$/"],
      "matchStrings": [
        "github:NousResearch/hermes-agent/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "NousResearch/hermes-agent",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "The hermes-agent input is pinned to a release tag in its declaration; the custom regex manager owns that pin, so the nix manager must not also rewrite the locked input.",
      "matchManagers": ["nix"],
      "matchDepNames": ["hermes-agent"],
      "enabled": false
    },
    {
      "description": "A nix-fleet bump is the fleet's baseline update: it moves the shared pins (nixpkgs, flake-parts, import-tree, treefmt-nix) as one change.",
      "matchManagers": ["nix"],
      "matchDepNames": ["nix-fleet"],
      "groupName": "nix-fleet baseline"
    },
    {
      "description": "Shared pins are owned by Shrub24/nix-fleet; updating them here would let the two repositories drift apart.",
      "matchManagers": ["nix"],
      "matchDepNames": ["nixpkgs", "flake-parts", "import-tree", "treefmt-nix"],
      "enabled": false
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix flake inputs"
    },
    {
      "matchManagers": ["custom.regex"],
      "groupName": "OCI image refs",
      "commitMessageTopic": "OCI image refs"
    }
  ],
  "rebaseWhen": "behind-base-branch"
}
