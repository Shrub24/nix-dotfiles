{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "noctalia",
  "vars": {
    "surface": "{{colors.surface.default.hex}}",
    "surfaceContainerLow": "{{colors.surface_container_low.default.hex}}",
    "surfaceContainerLowest": "{{colors.surface_container_lowest.default.hex}}",
    "surfaceContainer": "{{colors.surface_container.default.hex}}",
    "surfaceContainerHigh": "{{colors.surface_container_high.default.hex}}",
    "onSurface": "{{colors.on_surface.default.hex}}",
    "onSurfaceVariant": "{{colors.on_surface_variant.default.hex}}",
    "outline": "{{colors.outline.default.hex}}",
    "outlineVariant": "{{colors.outline_variant.default.hex}}",
    "primary": "{{colors.primary.default.hex}}",
    "primaryContainer": "{{colors.primary_container.default.hex}}",
    "primaryFixed": "{{colors.primary_fixed.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "secondaryFixedDim": "{{colors.secondary_fixed_dim.default.hex}}",
    "tertiary": "{{colors.tertiary.default.hex}}",
    "error": "{{colors.error.default.hex}}",
    "errorContainer": "{{colors.error_container.default.hex}}"
  },
  "colors": {
    "accent": "primary",
    "border": "outline",
    "borderAccent": "primary",
    "borderMuted": "outline",
    "success": "tertiary",
    "error": "error",
    "warning": "secondary",
    "muted": "onSurfaceVariant",
    "dim": "outline",
    "text": "",
    "thinkingText": "onSurfaceVariant",
    "selectedBg": "surfaceContainerHigh",
    "userMessageBg": "surfaceContainer",
    "userMessageText": "onSurface",
    "customMessageBg": "surfaceContainerLow",
    "customMessageText": "onSurface",
    "customMessageLabel": "primary",
    "toolPendingBg": "surfaceContainerLowest",
    "toolSuccessBg": "surfaceContainerLow",
    "toolErrorBg": "errorContainer",
    "toolTitle": "primary",
    "toolOutput": "",
    "mdHeading": "primary",
    "mdLink": "secondary",
    "mdLinkUrl": "onSurfaceVariant",
    "mdCode": "tertiary",
    "mdCodeBlock": "",
    "mdCodeBlockBorder": "outline",
    "mdQuote": "onSurfaceVariant",
    "mdQuoteBorder": "outline",
    "mdHr": "outline",
    "mdListBullet": "tertiary",
    "toolDiffAdded": "tertiary",
    "toolDiffRemoved": "error",
    "toolDiffContext": "onSurfaceVariant",
    "syntaxComment": "onSurfaceVariant",
    "syntaxKeyword": "secondary",
    "syntaxFunction": "primary",
    "syntaxVariable": "onSurface",
    "syntaxString": "tertiary",
    "syntaxNumber": "primaryFixed",
    "syntaxType": "secondaryFixedDim",
    "syntaxOperator": "primary",
    "syntaxPunctuation": "outline",
    "thinkingOff": "outlineVariant",
    "thinkingMinimal": "outline",
    "thinkingLow": "primary",
    "thinkingMedium": "tertiary",
    "thinkingHigh": "secondary",
    "thinkingXhigh": "error",
    "bashMode": "tertiary"
  }
}
