{
  "__SCHEMA__": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": true,
    "enforce_auth_on_inference": false
  },
  "auth_config": {
    "is_enabled": true,
    "disable_auth_on_inference": true
  },
  "config_store": {
    "enabled": true,
    "type": "sqlite",
    "config": { "path": "./config.db" }
  },
  "mcp": {
    "tool_manager_config": { "code_mode_binding_level": "server" },
    "client_configs": [
      {
        "name": "jcodemunch",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "jcodemunch-mcp",
          "envs": [
            "HOME",
            "PATH",
            "GOOGLE_API_KEY",
            "GOOGLE_EMBED_MODEL",
            "JCODEMUNCH_SUMMARIZER_PROVIDER",
            "MINIMAX_API_KEY"
          ]
        },
        "tools_to_execute": ["*"],
        "is_code_mode_client": true
      },
      {
        "name": "jdocmunch",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "jdocmunch-mcp",
          "envs": [
            "HOME",
            "PATH",
            "GOOGLE_API_KEY",
            "GOOGLE_EMBED_MODEL",
            "JDOCMUNCH_SUMMARIZER_PROVIDER",
            "MINIMAX_API_KEY"
          ]
        },
        "tools_to_execute": ["*"],
        "is_code_mode_client": true
      },
      {
        "name": "context7",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "pnpx",
          "args": ["@upstash/context7-mcp", "--api-key", "${CONTEXT7_API_KEY}"],
          "envs": ["HOME", "PATH", "CONTEXT7_API_KEY"]
        },
        "tools_to_execute": ["*"]
      },
      {
        "name": "gh-grep",
        "connection_type": "http",
        "connection_string": "https://mcp.grep.app",
        "tools_to_execute": ["*"]
      },
      {
        "name": "desktop-commander",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "pnpx",
          "args": ["@wonderwhy-er/desktop-commander@latest"],
          "envs": ["HOME", "PATH"]
        },
        "tools_to_execute": ["*"],
        "is_code_mode_client": true
      },
      {
        "name": "jina-reader",
        "connection_type": "http",
        "connection_string": "https://mcp.jina.ai/v1?include_tools=read_url,extract_pdf,parallel_read_url",
        "auth_type": "headers",
        "headers": { "Authorization": "Bearer ${JINA_TOKEN}" },
        "tools_to_execute": ["*"]
      },
      {
        "name": "tavily",
        "connection_type": "http",
        "connection_string": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}",
        "tools_to_execute": ["*"]
      },
      {
        "name": "brave_search",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "pnpx",
          "args": ["@brave/brave-search-mcp-server"],
          "envs": ["HOME", "PATH", "BRAVE_API_KEY"]
        },
        "tools_to_execute": ["*"]
      },
      {
        "name": "github",
        "connection_type": "http",
        "connection_string": "https://api.githubcopilot.com/mcp/",
        "auth_type": "headers",
        "headers": { "Authorization": "Bearer ${GITHUB_PAT}" },
        "tools_to_execute": ["*"],
        "is_code_mode_client": true
      },
      {
        "name": "firecrawl",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "pnpx",
          "args": ["firecrawl-mcp"],
          "envs": ["HOME", "PATH", "FIRECRAWL_API_KEY"]
        },
        "tools_to_execute": ["*"]
      },
      {
        "name": "kreuzberg",
        "connection_type": "stdio",
        "stdio_config": {
          "command": "kreuzberg",
          "args": ["mcp"],
          "envs": ["HOME", "PATH"]
        },
        "tools_to_execute": ["*"],
        "is_code_mode_client": true
      }
    ]
  },
  "governance": {
    "virtual_keys": [
      {
        "id": "web-research",
        "name": "web-research",
        "value": "sk-bf-web-research",
        "description": "Web search, content extraction, and web scraping",
        "mcp_configs": [
          { "mcp_client_name": "brave_search", "tools_to_execute": ["*"] },
          { "mcp_client_name": "tavily", "tools_to_execute": ["*"] },
          { "mcp_client_name": "jina_reader", "tools_to_execute": ["*"] },
          { "mcp_client_name": "firecrawl", "tools_to_execute": ["*"] },
          { "mcp_client_name": "gh_grep", "tools_to_execute": ["*"] }
        ]
      }
    ]
  }
}
